POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=scango

# The URLs that internal containers use
DATABASE_URL=postgresql://admin:supersecret@postgres:5432/scango

# ----------------------------------------
# Backend API (FastAPI) Configuration
# ----------------------------------------
# OpenSSL generated hex string is recommended
SECRET_KEY=9a4f2c8d3b7a1e6f4d5c8b9a0e1f2d3c4b5a69788796a5b4c3d2e1f0a9b8c7d6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Connection to Redis 
REDIS_URL=redis://redis:6379/0

# ----------------------------------------
# Frontend Configuration
# ----------------------------------------
# Must be accessible from the user's browser, usually localhost in dev
VITE_API_BASE_URL=http://localhost:8000
VITE_ML_API_BASE_URL=http://localhost:8001
